# Copy to .env.local (never committed) and fill in. In Vercel, set the same names under Settings → Environment Variables.

# Public — Sanity project (defaults already point to the Diente8 project)
NEXT_PUBLIC_SANITY_PROJECT_ID=l4rx459u
NEXT_PUBLIC_SANITY_DATASET=production

# Public — final domain, once connected (used by sitemap, canonical URLs, robots)
# NEXT_PUBLIC_SITE_URL=https://www.ejemplo.mx

# Secret — only for `npm run sanity:seed` (one-time content import). Not needed in Vercel.
SANITY_API_WRITE_TOKEN=

# Secret — contact form email (Resend). Set it in Vercel only.
RESEND_API_KEY=
